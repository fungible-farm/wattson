FROM docker.io/library/python:3.12-slim-bookworm
# unixODBC: LGPL-2.1; FreeTDS: LGPL-2.0; SQLite fixture driver: LGPL-2.1.
RUN apt-get update && apt-get install -y --no-install-recommends unixodbc tdsodbc libsqliteodbc ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache
COPY server.py proof.py ./
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
ENTRYPOINT ["python", "/app/server.py"]
