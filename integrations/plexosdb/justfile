# Run from this directory. Only Podman + just are needed on the host.
set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments := true
image := env("PLEXOSDB_IMAGE", "localhost/wattson-plexosdb:1.7.0")
# CPU/memory limits bound this example on shared hosts; large models need deliberate overrides.
memory := env("PLEXOSDB_MEMORY", "1g")
cpus := env("PLEXOSDB_CPUS", "1")
az_image := env("AZ_CLI_IMAGE", "mcr.microsoft.com/azure-cli:azurelinux3.0@sha256:36c0a3203ec83e44521a2d456e47bc007edd3d6edc0280faaef521812cf407f2")

# Show available commands.
default:
    @just --list

# Build only the isolated pinned integration; never copy client data into the image.
build:
    podman build --memory {{memory}} -f Containerfile -t {{image}} .

# Actual upstream import/export plus an OS-level read-only mount check; no network or account.
proof:
    podman run --rm --memory {{memory}} --cpus {{cpus}} --network none --read-only --cap-drop all --security-opt no-new-privileges --tmpfs /tmp:rw,size=256m -v "$PWD/fixtures:/input:ro" --entrypoint /app/.venv/bin/python {{image}} /app/proof.py

# Inspect a local input directory read-only. Filename may refer to a nested XML file.
inspect input filename="model.xml":
    #!/usr/bin/env bash
    set -euo pipefail
    input_dir=$(realpath -- "$1")
    test -d "$input_dir"
    podman run --rm --memory {{memory}} --cpus {{cpus}} --network none --read-only --cap-drop all --security-opt no-new-privileges --tmpfs /tmp:rw,size=256m -v "$input_dir:/input:ro" {{image}} "/input/$2"

# Log in interactively in a dedicated credential volume; never mount the host's whole home.
az-login:
    @podman volume exists wattson-plexos-az-auth || podman volume create wattson-plexos-az-auth >/dev/null
    podman run --rm -it --memory {{memory}} --cpus {{cpus}} -e AZURE_CONFIG_DIR=/auth -v wattson-plexos-az-auth:/auth {{az_image}} az login --use-device-code --output none

# Stage ONE blob up to 256 MiB and 10 minutes, with ETag consistency and no overwrite.
# Storage Blob Data Reader is enough; auth-mode login avoids account keys.
az-stage account container blob:
    @podman volume exists wattson-plexos-input || podman volume create wattson-plexos-input >/dev/null
    @podman volume exists wattson-plexos-az-auth
    podman run --rm --timeout 600 --memory {{memory}} --cpus {{cpus}} -e AZURE_CONFIG_DIR=/auth -v wattson-plexos-az-auth:/auth -v wattson-plexos-input:/stage -v "$PWD/stage_blob.sh:/stage_blob.sh:ro" {{az_image}} bash /stage_blob.sh "$1" "$2" "$3"

# Query the downloaded volume offline/read-only; this container receives no Azure identity.
az-inspect:
    @podman volume exists wattson-plexos-input
    podman run --rm --memory {{memory}} --cpus {{cpus}} --network none --read-only --cap-drop all --security-opt no-new-privileges --tmpfs /tmp:rw,size=256m -v wattson-plexos-input:/input:ro {{image}}
