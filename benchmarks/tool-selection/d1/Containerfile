# CPU-only runtime for the d1-3B tool-selection evaluation (#151). Network is needed at build time only;
# run it with --network none, --read-only and a memory cap (the host hook rejects uncapped containers).
FROM docker.io/library/python:3.12-slim
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir "transformers>=5.14,<6" pillow huggingface_hub safetensors
ENV HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
